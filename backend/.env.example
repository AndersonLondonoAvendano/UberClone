# Copy to backend/.env and fill in the values. Names only here: never commit real values.
MP_ACCESS_TOKEN=
FIREBASE_SERVICE_ACCOUNT_PATH=
PUBLIC_BASE_URL=
PORT=
# Optional: when set, webhook signatures (x-signature) are verified.
MP_WEBHOOK_SECRET=
# Optional Stripe (test keys only: live keys are rejected). Names only here.
STRIPE_SECRET_KEY=
# Optional: when set, the Stripe-Signature of POST /webhooks/stripe is verified; without it that route refuses everything.
STRIPE_WEBHOOK_SECRET=
# Optional: defaults to cop. usd is a test-only fallback that also needs STRIPE_COP_PER_USD.
STRIPE_CURRENCY=
STRIPE_COP_PER_USD=
# Optional automatic simulated requests (names only; each falls back to a safe default when empty or invalid).
AUTO_REQUEST_FIRST_MIN_S=
AUTO_REQUEST_FIRST_MAX_S=
AUTO_REQUEST_NEXT_MIN_S=
AUTO_REQUEST_NEXT_MAX_S=
AUTO_REQUEST_MAX_PER_SESSION=
AUTO_REQUEST_HEARTBEAT_MAX_MIN=
# App side (root .env of the Expo app, name only): EXPO_PUBLIC_BACKEND_URL
