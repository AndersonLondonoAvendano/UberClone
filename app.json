{
  "expo": {
    "name": "uber-clone",
    "slug": "uber-clone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.andersonlondono.uberclone"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.andersonlondono.uberclone",
      "userInterfaceStyle": "light"
    },
    "plugins": [
      "expo-system-ui",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "UberClone Conductor necesita la cámara para tomar tu foto de perfil y la foto de tu vehículo.",
          "photosPermission": "UberClone Conductor necesita tu galería para elegir tu foto de perfil o la de tu vehículo.",
          "microphonePermission": false
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "UberClone Conductor necesita tu ubicación mientras usas la app para mostrar tu posición en el mapa y calcular la ruta hacia el pasajero."
        }
      ],
      "expo-font"
    ]
  }
}
